# Copy to .env and fill in real values. Never commit .env.

# Renpho account that has every client added as a "friend"
RENPHO_EMAIL=renpho-account@example.com
RENPHO_PASSWORD=change-me

# Trainerize API (Settings > Add-ons > API in the Trainerize admin)
TZ_GROUP_ID=your-trainerize-group-id
TZ_API_TOKEN=your-trainerize-api-token

# Google Sheets (service account JSON key; share the sheet with its client_email)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_CREDENTIALS_JSON=credentials.json
# Optional: sheet holding the "Client Merged Data" tab (defaults to GOOGLE_SHEET_ID)
MERGER_SHEET_ID=

# Optional: only process Trainerize clients whose name contains this text
CLIENT_FILTER=
